# The database is accumulated state, not source code. It lives on the
# server and is rebuilt by the engine — never commit it, and never let a
# laptop copy overwrite the server's.
data/*
!data/.gitkeep

# Scrape run logs
logs/
*.log

# Secrets: Phase 4 (email/push) will put credentials here.
.env
config.txt
*.pem
*.key

__pycache__/
*.pyc
.DS_Store
